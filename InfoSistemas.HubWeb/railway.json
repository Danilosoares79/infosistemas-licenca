{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "InfoSistemas.HubWeb/Dockerfile"
  },
  "deploy": {
    "startCommand": "dotnet InfoSistemas.HubWeb.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
