@page "/login"
@layout EmptyLayout
@using InfoSistemas.HubWeb.DTOs
@using InfoSistemas.HubWeb.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Extensions.Head
@inject AuthApiService AuthApi
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Login - InfoSistemas Hub</PageTitle>

<div class="login-bg">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo">IS</div>
            <h1>InfoSistemas Hub</h1>
            <p class="login-subtitle">Sistema de Gerenciamento de Licencas</p>
        </div>

        <form @onsubmit="DoLogin" @onsubmit:preventDefault>
            <div class="login-field">
                <label>Login</label>
                <input type="text" @bind="login" @bind:event="oninput" autofocus disabled="@loading"/>
            </div>

            <div class="login-field">
                <label>Senha</label>
                <input type="password" @bind="senha" @bind:event="oninput" disabled="@loading"/>
            </div>

            <div class="login-field-check">
                <label>
                    <input type="checkbox" @bind="lembrar" disabled="@loading"/>
                    <span>Lembrar de mim</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="login-erro">@erro</div>
            }

            <button type="submit" class="login-btn" disabled="@loading">
                @(loading ? "Entrando..." : "Entrar")
            </button>
        </form>

        <div class="login-rodape">
            <small>InfoSistemas &copy; @DateTime.Now.Year</small>
        </div>
    </div>
</div>

@code {
    private string login = "";
    private string senha = "";
    private bool lembrar = true;
    private string? erro;
    private bool loading;

    private async Task DoLogin()
    {
        erro = null;
        loading = true;

        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(senha))
        {
            erro = "Informe login e senha";
            loading = false;
            return;
        }

        var resp = await AuthApi.LoginAsync(login.Trim(), senha);
        if (!resp.Sucesso || resp.Usuario == null)
        {
            erro = resp.Mensagem ?? "Falha ao autenticar";
            loading = false;
            return;
        }

        AuthState.SetUsuario(resp.Usuario, resp.TrocarSenha);

        if (resp.TrocarSenha)
            Nav.NavigateTo("/alterar-senha");
        else
            Nav.NavigateTo("/");
    }
}
