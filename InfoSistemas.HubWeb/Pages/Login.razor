@page "/login"
@layout EmptyLayout
@using InfoSistemas.HubWeb.DTOs
@using InfoSistemas.HubWeb.Services
@inject AuthApiService AuthApi
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Login - InfoSistemas Hub</PageTitle>

<div class="login-bg">
    <div class="login-card">
        <div class="login-brand">
            <img src="css/logo_infosistemas.jpg"
                 alt="InfoSistemas"
                 class="login-logo-img"
                 onerror="this.style.display='none'; document.getElementById('logo-fallback').style.display='inline-flex';" />
            <div class="login-logo" id="logo-fallback" style="display:none;">IS</div>
            <h1>InfoSistemas Hub</h1>
            <p class="login-subtitle">Sistema de Gerenciamento de Licencas</p>
        </div>

        <form @onsubmit="DoLogin" @onsubmit:preventDefault>
            <div class="login-field">
                <label>Login</label>
                <input type="text" @bind="login" @bind:event="oninput" autofocus disabled="@loading"/>
            </div>
            <div class="login-field">
                <label>Senha</label>
                <input type="password" @bind="senha" @bind:event="oninput" disabled="@loading"/>
            </div>
            <div class="login-field-check">
                <label>
                    <input type="checkbox" @bind="lembrar" disabled="@loading"/>
                    <span>Lembrar de mim</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="login-erro">@erro</div>
            }

            <button type="submit" class="login-btn" disabled="@loading">
                @(loading ? "Entrando..." : "Entrar")
            </button>
        </form>

        <div class="login-rodape">
            <small>InfoSistemas &copy; @DateTime.Now.Year &mdash; Todos os direitos reservados</small>
        </div>
    </div>
</div>

@code {
    private string login = "";
    private string senha = "";
    private bool lembrar = true;
    private string? erro;
    private bool loading;

    private async Task DoLogin()
    {
        erro = null;
        loading = true;

        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(senha))
        {
            erro = "Informe login e senha";
            loading = false;
            return;
        }

        var resp = await AuthApi.LoginAsync(login.Trim(), senha);
        if (!resp.Sucesso || resp.Usuario == null)
        {
            erro = resp.Mensagem ?? "Falha ao autenticar";
            loading = false;
            return;
        }

        AuthState.SetUsuario(resp.Usuario, resp.TrocarSenha);

        // Salvar sessao no browser para sobreviver a F5 / hard navigation
        await SalvarSessaoAsync(resp.Usuario, resp.TrocarSenha, lembrar);

        if (resp.TrocarSenha)
            Nav.NavigateTo("/alterar-senha");
        else
            Nav.NavigateTo("/");
    }

    private async Task SalvarSessaoAsync(UsuarioDto usuario, bool trocarSenha, bool persistente)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new SessaoSalva(
                usuario.Id, usuario.Login, usuario.Nome,
                usuario.Email, usuario.Perfil, usuario.Ativo,
                usuario.UltimoAcesso, usuario.DataCriacao, trocarSenha));

            // sessionStorage: dura ate fechar o browser
            await JS.InvokeVoidAsync("sessionStorage.setItem", "is_sessao", json);

            // localStorage: persiste entre sessoes (so se marcou "lembrar de mim")
            if (persistente)
                await JS.InvokeVoidAsync("localStorage.setItem", "is_sessao", json);
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", "is_sessao");
        }
        catch { /* JS pode nao estar disponivel ainda */ }
    }

    public record SessaoSalva(
        int Id, string Login, string Nome, string? Email,
        string Perfil, bool Ativo, DateTime? UltimoAcesso,
        DateTime DataCriacao, bool TrocarSenha);
}
