@page "/clientes/novo"
@page "/clientes/{Id:int}/editar"
@using InfoSistemas.HubWeb.DTOs
@using InfoSistemas.HubWeb.Services
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@inject LicencaApiService Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory

<h2>@(Id == 0 ? "Novo Cliente" : "Editar Cliente")</h2>

@if (!AuthState.CanEditClientes)
{
    <div class="alert alert-danger">Voce nao tem permissao para cadastrar clientes.</div>
}
else
{
    <div class="form-card">
        <!-- DADOS DA EMPRESA -->
        <div class="form-section">
            <h3>Dados da Empresa</h3>
            <div class="form-row">
                <div class="form-group" style="max-width:220px;">
                    <label>CNPJ *</label>
                    <div style="display:flex;gap:6px;align-items:center;">
                        <input class="hub-input" @bind="cnpj" @bind:event="oninput"
                               @onblur="BuscarCnpj"
                               placeholder="00.000.000/0001-00"
                               disabled="@(salvando || buscandoCnpj)"/>
                        @if (buscandoCnpj)
                        {
                            <span style="color:#6b7280;font-size:12px;white-space:nowrap;">Buscando...</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(erroCnpj))
                    {
                        <small style="color:#dc2626;">@erroCnpj</small>
                    }
                    @if (cnpjEncontrado)
                    {
                        <small style="color:#15803d;">Dados preenchidos automaticamente!</small>
                    }
                </div>
                <div class="form-group flex-2">
                    <label>Razao Social *</label>
                    <input class="hub-input" @bind="razao" placeholder="Razao Social" disabled="@salvando"/>
                </div>
                <div class="form-group flex-2">
                    <label>Nome Fantasia</label>
                    <input class="hub-input" @bind="fantasia" placeholder="Fantasia" disabled="@salvando"/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>E-mail</label>
                    <input class="hub-input" @bind="email" placeholder="contato@empresa.com" disabled="@salvando"/>
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input class="hub-input" @bind="fone" placeholder="(00) 00000-0000" disabled="@salvando"/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group flex-3">
                    <label>Endereco</label>
                    <input class="hub-input" @bind="endereco" placeholder="Rua, numero" disabled="@salvando"/>
                </div>
                <div class="form-group flex-2">
                    <label>Cidade</label>
                    <input class="hub-input" @bind="cidade" disabled="@salvando"/>
                </div>
                <div class="form-group">
                    <label>UF</label>
                    <input class="hub-input" @bind="uf" maxlength="2" style="width:60px" disabled="@salvando"/>
                </div>
                <div class="form-group">
                    <label>CEP</label>
                    <input class="hub-input" @bind="cep" placeholder="00000-000" disabled="@salvando"/>
                </div>
            </div>
        </div>

        <!-- LICENCA E PLANO -->
        <div class="form-section">
            <h3>Licenca e Plano</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Plano</label>
                    <select class="hub-select" @bind="plano" disabled="@salvando">
                        <option value="BASICO">Basico (1 Desktop)</option>
                        <option value="PROFISSIONAL">Profissional</option>
                        <option value="ENTERPRISE">Enterprise</option>
                    </select>
                </div>

                <!-- MAX DESKTOPS -->
                <div class="form-group">
                    <label>Max. Desktops (PDV)</label>
                    <input class="hub-input" type="number" min="1" max="50"
                           @bind="maxDesktops" @bind:event="oninput"
                           style="width:80px" disabled="@salvando"/>
                    @if (Id > 0)
                    {
                        <small>Ativos: <strong>@desktopsAtivos</strong> / Limite atual: <strong>@maxDesktopsOriginal</strong></small>
                        @if (maxDesktops > maxDesktopsOriginal)
                        {
                            <div class="limite-ok">
                                +@(maxDesktops - maxDesktopsOriginal) PDV(s) adicionais poderão se conectar automaticamente.
                            </div>
                        }
                        else if (maxDesktops < desktopsAtivos)
                        {
                            <div class="limite-alerta">
                                ⚠ @(desktopsAtivos - maxDesktops) Desktop(s) serao desconectados (os menos recentes).
                            </div>
                        }
                        else if (maxDesktops < maxDesktopsOriginal)
                        {
                            <div class="limite-info">
                                Novo limite: @maxDesktops Desktop(s). Nenhum ativo sera afetado.
                            </div>
                        }
                    }
                    else
                    {
                        <small>Limite de computadores com PDV</small>
                    }
                </div>

                <!-- MAX MOBILE -->
                <div class="form-group">
                    <label>Max. Mobile (Garcom)</label>
                    <input class="hub-input" type="number" min="0" max="100"
                           @bind="maxMobile" @bind:event="oninput"
                           style="width:80px" disabled="@salvando"/>
                    @if (Id > 0)
                    {
                        <small>Ativos: <strong>@mobileAtivos</strong> / Limite atual: <strong>@maxMobileOriginal</strong></small>
                        @if (maxMobile > maxMobileOriginal)
                        {
                            <div class="limite-ok">
                                +@(maxMobile - maxMobileOriginal) Garcom(ns) adicionais poderão se conectar automaticamente.
                            </div>
                        }
                        else if (maxMobile < mobileAtivos)
                        {
                            <div class="limite-alerta">
                                ⚠ @(mobileAtivos - maxMobile) Mobile(s) serao desconectados (os menos recentes).
                            </div>
                        }
                        else if (maxMobile < maxMobileOriginal)
                        {
                            <div class="limite-info">
                                Novo limite: @maxMobile Mobile(s). Nenhum ativo sera afetado.
                            </div>
                        }
                    }
                    else
                    {
                        <small>Limite de garcons mobile</small>
                    }
                </div>

                <div class="form-group">
                    <label>Vencimento *</label>
                    <input class="hub-input" type="date" @bind="vencimento" disabled="@salvando"/>
                </div>
            </div>

            <!-- Aviso resumo quando há redução -->
            @if (Id > 0 && (maxDesktops < desktopsAtivos || maxMobile < mobileAtivos))
            {
                <div class="reducao-aviso">
                    <strong>Atencao:</strong> Ao salvar, os dispositivos excedentes serao desconectados automaticamente.
                    O sistema remove os que tiveram acesso mais antigo, mantendo os mais recentes.
                    Os dispositivos removidos nao poderao mais usar o sistema ate que voce aumente o limite novamente.
                </div>
            }

            <!-- Info quando só aumentou -->
            @if (Id > 0 && maxDesktops >= desktopsAtivos && maxMobile >= mobileAtivos
                 && (maxDesktops > maxDesktopsOriginal || maxMobile > maxMobileOriginal))
            {
                <div class="reducao-info-aumento">
                    Os novos dispositivos podem se conectar imediatamente sem necessidade de novo arquivo .lic.
                    A licenca e validada online automaticamente.
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(erro))
        {
            <div class="alert alert-danger">@erro</div>
        }
        @if (!string.IsNullOrEmpty(sucesso))
        {
            <div class="alert alert-success">@sucesso</div>
        }

        <div class="form-actions">
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo(Id > 0 ? $"/clientes/{Id}" : "/clientes")'>
                Cancelar
            </button>
            <button class="btn-primary" @onclick="Salvar" disabled="@salvando">
                @(salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Dados do formulário
    string razao = "", fantasia = "", cnpj = "", email = "", fone = "";
    string endereco = "", cidade = "", uf = "", cep = "";
    string plano = "PROFISSIONAL";
    int maxDesktops = 1, maxMobile = 0;
    DateTime vencimento = DateTime.Today.AddDays(30);

    // Estado original (para comparar mudanças)
    int maxDesktopsOriginal = 1, maxMobileOriginal = 0;
    int desktopsAtivos = 0, mobileAtivos = 0;

    // Feedback
    string erro = "", sucesso = "", erroCnpj = "";
    bool salvando, buscandoCnpj, cnpjEncontrado;

    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated) Nav.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            // Carregar dados do cliente
            var c = await Api.ObterClienteAsync(Id);
            if (c != null)
            {
                razao              = c.RazaoSocial;
                fantasia           = c.Fantasia;
                cnpj               = c.Cnpj;
                email              = c.Email;
                plano              = c.Plano;
                maxDesktops        = c.MaxDesktops;
                maxDesktopsOriginal = c.MaxDesktops;
                maxMobile          = c.MaxMobile;
                maxMobileOriginal  = c.MaxMobile;
                vencimento         = c.DataVencimento;

                // Quantos dispositivos estão ativos hoje
                desktopsAtivos = c.DesktopsAtivos;
                mobileAtivos   = c.MobileAtivos;
            }
        }
    }

    // ── Auto-preenchimento via CNPJ (BrasilAPI) ───────────────────────
    private async Task BuscarCnpj()
    {
        erroCnpj = "";
        cnpjEncontrado = false;
        var cnpjLimpo = Regex.Replace(cnpj, @"[^\d]", "");
        if (cnpjLimpo.Length != 14) return;

        buscandoCnpj = true;
        StateHasChanged();

        try
        {
            var resp = await HttpFactory.CreateClient("brasilapi")
                .GetAsync($"https://brasilapi.com.br/api/cnpj/v1/{cnpjLimpo}");

            if (!resp.IsSuccessStatusCode)
            {
                erroCnpj = "CNPJ nao encontrado na Receita Federal.";
                return;
            }

            var dados = await resp.Content.ReadFromJsonAsync<BrasilApiCnpjDto>();
            if (dados == null) return;

            razao    = dados.razao_social    ?? razao;
            fantasia = dados.nome_fantasia   ?? fantasia;
            email    = dados.email           ?? email;

            if (!string.IsNullOrEmpty(dados.ddd_telefone_1))
            {
                var tel = Regex.Replace(dados.ddd_telefone_1, @"[^\d]", "");
                fone = tel.Length >= 10
                    ? $"({tel[..2]}) {tel[2..].Insert(tel.Length - 2 - 4, "-")}"
                    : dados.ddd_telefone_1;
            }

            var logradouro = dados.logradouro ?? "";
            var numero     = dados.numero ?? "";
            var comp       = dados.complemento ?? "";
            endereco = string.Join(", ", new[] { logradouro, numero, comp }
                .Where(s => !string.IsNullOrWhiteSpace(s)));

            cidade = dados.municipio ?? cidade;
            uf     = dados.uf        ?? uf;
            cep    = dados.cep != null
                ? Regex.Replace(dados.cep, @"(\d{5})(\d{3})", "$1-$2")
                : cep;

            if (cnpjLimpo.Length == 14)
                cnpj = $"{cnpjLimpo[..2]}.{cnpjLimpo[2..5]}.{cnpjLimpo[5..8]}/{cnpjLimpo[8..12]}-{cnpjLimpo[12..]}";

            cnpjEncontrado = true;
        }
        catch
        {
            erroCnpj = "Erro ao consultar CNPJ. Preencha os dados manualmente.";
        }
        finally
        {
            buscandoCnpj = false;
            StateHasChanged();
        }
    }

    async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(razao) || string.IsNullOrWhiteSpace(cnpj))
        {
            erro = "Razao Social e CNPJ sao obrigatorios.";
            return;
        }
        if (maxDesktops < 1)
        {
            erro = "Max. Desktops deve ser no minimo 1.";
            return;
        }

        salvando = true; erro = ""; sucesso = "";
        try
        {
            if (Id == 0)
            {
                var req = new CriarClienteRequest(razao, fantasia, cnpj, email, fone,
                    endereco, cidade, uf, cep, plano, maxDesktops, maxMobile, vencimento);
                var c = await Api.CriarClienteAsync(req);
                sucesso = $"Cliente criado com sucesso! Chave de licenca: {c?.Chave}";
                await Task.Delay(2000);
                Nav.NavigateTo($"/clientes/{c?.Id}");
            }
            else
            {
                var req = new AtualizarClienteRequest(razao, fantasia, email, fone,
                    endereco, cidade, uf, cep, plano, maxDesktops, maxMobile);
                await Api.AtualizarClienteAsync(Id, req);

                // Remover dispositivos excedentes automaticamente se diminuiu o limite
                var msgs = new List<string> { "Dados atualizados com sucesso!" };

                if (maxDesktops < desktopsAtivos)
                {
                    var (removidos, _) = await Api.RemoverExcedentesAsync(Id, "DESKTOP", maxDesktops);
                    if (removidos > 0)
                        msgs.Add($"{removidos} Desktop(s) desconectado(s) automaticamente.");
                }

                if (maxMobile < mobileAtivos)
                {
                    var (removidos, _) = await Api.RemoverExcedentesAsync(Id, "MOBILE", maxMobile);
                    if (removidos > 0)
                        msgs.Add($"{removidos} Mobile(s) desconectado(s) automaticamente.");
                }

                sucesso = string.Join(" ", msgs);

                // Atualizar contadores locais
                maxDesktopsOriginal = maxDesktops;
                maxMobileOriginal   = maxMobile;
                desktopsAtivos      = Math.Min(desktopsAtivos, maxDesktops);
                mobileAtivos        = Math.Min(mobileAtivos, maxMobile);
            }
        }
        catch (Exception ex) { erro = $"Erro: {ex.Message}"; }
        finally { salvando = false; }
    }

    // ── DTO para a resposta da BrasilAPI ─────────────────────────────
    private class BrasilApiCnpjDto
    {
        public string? razao_social  { get; set; }
        public string? nome_fantasia { get; set; }
        public string? email         { get; set; }
        public string? ddd_telefone_1 { get; set; }
        public string? logradouro    { get; set; }
        public string? numero        { get; set; }
        public string? complemento   { get; set; }
        public string? municipio     { get; set; }
        public string? uf            { get; set; }
        public string? cep           { get; set; }
    }
}
