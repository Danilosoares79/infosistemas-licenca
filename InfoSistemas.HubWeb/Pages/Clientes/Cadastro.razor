@page "/clientes/novo"
@page "/clientes/{Id:int}/editar"
@using InfoSistemas.HubWeb.DTOs
@using InfoSistemas.HubWeb.Services
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@inject LicencaApiService Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory

<h2>@(Id == 0 ? "Novo Cliente" : "Editar Cliente")</h2>

@if (!AuthState.CanEditClientes)
{
    <div class="alert alert-danger">Voce nao tem permissao para cadastrar clientes.</div>
}
else
{
    <div class="form-card">
        <!-- DADOS DA EMPRESA / PESSOA -->
        <div class="form-section">
            <h3>Dados do Cliente</h3>

            <!-- Tipo: Pessoa Juridica ou Fisica -->
            <div class="form-row" style="margin-bottom:10px;">
                <div class="form-group">
                    <label>Tipo de Cadastro</label>
                    <div style="display:flex;gap:16px;margin-top:4px;">
                        <label class="radio-label @(tipoPessoa == "J" ? "radio-ativo" : "")">
                            <input type="radio" @onchange='() => MudarTipo("J")'
                                   checked="@(tipoPessoa == "J")" disabled="@(salvando || Id > 0)"/>
                            Pessoa Juridica (CNPJ)
                        </label>
                        <label class="radio-label @(tipoPessoa == "F" ? "radio-ativo" : "")">
                            <input type="radio" @onchange='() => MudarTipo("F")'
                                   checked="@(tipoPessoa == "F")" disabled="@(salvando || Id > 0)"/>
                            Pessoa Fisica (CPF)
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-row">
                <!-- Documento: CNPJ ou CPF -->
                <div class="form-group" style="max-width:220px;">
                    <label>@(tipoPessoa == "J" ? "CNPJ *" : "CPF *")</label>
                    <div style="display:flex;gap:6px;align-items:center;">
                        <input class="hub-input"
                               @bind="documento" @bind:event="oninput"
                               @onblur="AoSairDocumento"
                               placeholder="@(tipoPessoa == "J" ? "00.000.000/0001-00" : "000.000.000-00")"
                               maxlength="@(tipoPessoa == "J" ? 18 : 14)"
                               disabled="@(salvando || buscando)"/>
                        @if (buscando)
                        {
                            <span style="color:#6b7280;font-size:12px;white-space:nowrap;">Buscando...</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(erroDocumento))
                    {
                        <small style="color:#dc2626;">@erroDocumento</small>
                    }
                    @if (cnpjEncontrado)
                    {
                        <small style="color:#15803d;">Dados preenchidos automaticamente!</small>
                    }
                    @if (tipoPessoa == "F" && documentoValido)
                    {
                        <small style="color:#15803d;">CPF valido!</small>
                    }
                </div>

                <div class="form-group flex-2">
                    <label>@(tipoPessoa == "J" ? "Razao Social *" : "Nome Completo *")</label>
                    <input class="hub-input" @bind="razao" placeholder="@(tipoPessoa == "J" ? "Razao Social" : "Nome Completo")" disabled="@salvando"/>
                </div>

                @if (tipoPessoa == "J")
                {
                    <div class="form-group flex-2">
                        <label>Nome Fantasia</label>
                        <input class="hub-input" @bind="fantasia" placeholder="Fantasia" disabled="@salvando"/>
                    </div>
                }
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>E-mail</label>
                    <input class="hub-input" @bind="email" placeholder="contato@empresa.com" disabled="@salvando"/>
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input class="hub-input" @bind="fone" placeholder="(00) 00000-0000" disabled="@salvando"/>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group flex-3">
                    <label>Endereco</label>
                    <input class="hub-input" @bind="endereco" placeholder="Rua, numero" disabled="@salvando"/>
                </div>
                <div class="form-group flex-2">
                    <label>Cidade</label>
                    <input class="hub-input" @bind="cidade" disabled="@salvando"/>
                </div>
                <div class="form-group">
                    <label>UF</label>
                    <input class="hub-input" @bind="uf" maxlength="2" style="width:60px" disabled="@salvando"/>
                </div>
                <div class="form-group">
                    <label>CEP</label>
                    <input class="hub-input" @bind="cep" placeholder="00000-000" disabled="@salvando"/>
                </div>
            </div>
        </div>

        <!-- LICENCA E PLANO -->
        <div class="form-section">
            <h3>Licenca e Plano</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Plano</label>
                    <select class="hub-select" @bind="plano" disabled="@salvando">
                        <option value="BASICO">Basico (1 Desktop)</option>
                        <option value="PROFISSIONAL">Profissional</option>
                        <option value="ENTERPRISE">Enterprise</option>
                    </select>
                </div>

                <!-- MAX DESKTOPS -->
                <div class="form-group">
                    <label>Max. Desktops (PDV)</label>
                    <input class="hub-input" type="number" min="1" max="50"
                           @bind="maxDesktops" @bind:event="oninput"
                           style="width:80px" disabled="@salvando"/>
                    @if (Id > 0)
                    {
                        <small>Ativos: <strong>@desktopsAtivos</strong> / Anterior: <strong>@maxDesktopsOriginal</strong></small>
                        @if (maxDesktops > maxDesktopsOriginal)
                        {
                            <div class="limite-ok">+@(maxDesktops - maxDesktopsOriginal) PDV(s) adicionais poderão se conectar automaticamente.</div>
                        }
                        else if (maxDesktops < desktopsAtivos)
                        {
                            <div class="limite-alerta">⚠ @(desktopsAtivos - maxDesktops) Desktop(s) serao desconectados (os menos recentes).</div>
                        }
                        else if (maxDesktops < maxDesktopsOriginal)
                        {
                            <div class="limite-info">Novo limite: @maxDesktops Desktop(s). Nenhum ativo sera afetado.</div>
                        }
                    }
                    else
                    {
                        <small>Limite de computadores com PDV</small>
                    }
                </div>

                <!-- MAX MOBILE -->
                <div class="form-group">
                    <label>Max. Mobile (Garcom)</label>
                    <input class="hub-input" type="number" min="0" max="100"
                           @bind="maxMobile" @bind:event="oninput"
                           style="width:80px" disabled="@salvando"/>
                    @if (Id > 0)
                    {
                        <small>Ativos: <strong>@mobileAtivos</strong> / Anterior: <strong>@maxMobileOriginal</strong></small>
                        @if (maxMobile > maxMobileOriginal)
                        {
                            <div class="limite-ok">+@(maxMobile - maxMobileOriginal) Garcom(ns) adicionais poderão se conectar automaticamente.</div>
                        }
                        else if (maxMobile < mobileAtivos)
                        {
                            <div class="limite-alerta">⚠ @(mobileAtivos - maxMobile) Mobile(s) serao desconectados (os menos recentes).</div>
                        }
                        else if (maxMobile < maxMobileOriginal)
                        {
                            <div class="limite-info">Novo limite: @maxMobile Mobile(s). Nenhum ativo sera afetado.</div>
                        }
                    }
                    else
                    {
                        <small>Limite de garcons mobile</small>
                    }
                </div>

                <div class="form-group">
                    <label>Vencimento *</label>
                    <input class="hub-input" type="date" @bind="vencimento" disabled="@salvando"/>
                </div>
            </div>

            @if (Id > 0 && (maxDesktops < desktopsAtivos || maxMobile < mobileAtivos))
            {
                <div class="reducao-aviso">
                    <strong>Atencao:</strong> Ao salvar, os dispositivos excedentes serao desconectados automaticamente.
                    O sistema remove os que tiveram acesso mais antigo, mantendo os mais recentes.
                </div>
            }

            @if (Id > 0 && maxDesktops >= desktopsAtivos && maxMobile >= mobileAtivos
                 && (maxDesktops > maxDesktopsOriginal || maxMobile > maxMobileOriginal))
            {
                <div class="reducao-info-aumento">
                    Os novos dispositivos podem se conectar imediatamente sem necessidade de novo arquivo .lic.
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(erro))   { <div class="alert alert-danger">@erro</div> }
        @if (!string.IsNullOrEmpty(sucesso)) { <div class="alert alert-success">@sucesso</div> }

        <div class="form-actions">
            <button class="btn-secondary" @onclick='() => Nav.NavigateTo(Id > 0 ? $"/clientes/{Id}" : "/clientes")'>
                Cancelar
            </button>
            <button class="btn-primary" @onclick="Salvar" disabled="@salvando">
                @(salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Tipo: J = Juridica (CNPJ) / F = Fisica (CPF)
    string tipoPessoa = "J";
    string documento = "", razao = "", fantasia = "", email = "", fone = "";
    string endereco = "", cidade = "", uf = "", cep = "";
    string plano = "PROFISSIONAL";
    int maxDesktops = 1, maxMobile = 0;
    DateTime vencimento = DateTime.Today.AddDays(30);

    int maxDesktopsOriginal = 1, maxMobileOriginal = 0;
    int desktopsAtivos = 0, mobileAtivos = 0;

    string erro = "", sucesso = "", erroDocumento = "";
    bool salvando, buscando, cnpjEncontrado, documentoValido;

    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated) Nav.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            var c = await Api.ObterClienteAsync(Id);
            if (c != null)
            {
                documento           = c.Cnpj;
                razao               = c.RazaoSocial;
                fantasia            = c.Fantasia;
                email               = c.Email;
                plano               = c.Plano;
                maxDesktops         = c.MaxDesktops;
                maxDesktopsOriginal = c.MaxDesktops;
                maxMobile           = c.MaxMobile;
                maxMobileOriginal   = c.MaxMobile;
                vencimento          = c.DataVencimento;
                desktopsAtivos      = c.DesktopsAtivos;
                mobileAtivos        = c.MobileAtivos;

                // Detectar tipo pelo tamanho do documento salvo
                var digitos = Regex.Replace(c.Cnpj, @"[^\d]", "");
                tipoPessoa = digitos.Length == 11 ? "F" : "J";
            }
        }
    }

    void MudarTipo(string tipo)
    {
        tipoPessoa     = tipo;
        documento      = "";
        erroDocumento  = "";
        cnpjEncontrado = false;
        documentoValido = false;
    }

    // ── Chamado ao sair do campo documento ────────────────────────────
    private async Task AoSairDocumento()
    {
        erroDocumento   = "";
        cnpjEncontrado  = false;
        documentoValido = false;

        var digitos = Regex.Replace(documento, @"[^\d]", "");

        if (digitos.Length == 0) return;

        if (tipoPessoa == "F")
        {
            // CPF: validar e formatar
            if (digitos.Length != 11)
            {
                erroDocumento = "CPF invalido. Digite os 11 digitos.";
                return;
            }
            if (!ValidarCpf(digitos))
            {
                erroDocumento = "CPF invalido. Verifique os digitos.";
                return;
            }
            // Formatar CPF: 000.000.000-00
            documento = $"{digitos[..3]}.{digitos[3..6]}.{digitos[6..9]}-{digitos[9..]}";
            documentoValido = true;
            // CPF nao tem API publica (privacidade/LGPD) — nao busca dados
        }
        else
        {
            // CNPJ: validar, formatar e buscar dados na Receita Federal
            if (digitos.Length != 14)
            {
                erroDocumento = "CNPJ invalido. Digite os 14 digitos.";
                return;
            }
            if (!ValidarCnpj(digitos))
            {
                erroDocumento = "CNPJ invalido. Verifique os digitos.";
                return;
            }
            // Formatar CNPJ: 00.000.000/0001-00
            documento = $"{digitos[..2]}.{digitos[2..5]}.{digitos[5..8]}/{digitos[8..12]}-{digitos[12..]}";

            // Buscar dados na BrasilAPI
            await BuscarCnpj(digitos);
        }
    }

    private async Task BuscarCnpj(string cnpjLimpo)
    {
        buscando = true;
        StateHasChanged();
        try
        {
            var resp = await HttpFactory.CreateClient("brasilapi")
                .GetAsync($"https://brasilapi.com.br/api/cnpj/v1/{cnpjLimpo}");

            if (!resp.IsSuccessStatusCode)
            {
                erroDocumento = "CNPJ nao encontrado na Receita Federal.";
                return;
            }

            var dados = await resp.Content.ReadFromJsonAsync<BrasilApiCnpjDto>();
            if (dados == null) return;

            razao    = dados.razao_social    ?? razao;
            fantasia = dados.nome_fantasia   ?? fantasia;
            email    = dados.email           ?? email;

            if (!string.IsNullOrEmpty(dados.ddd_telefone_1))
            {
                var tel = Regex.Replace(dados.ddd_telefone_1, @"[^\d]", "");
                fone = tel.Length >= 10
                    ? $"({tel[..2]}) {tel[2..].Insert(tel.Length - 2 - 4, "-")}"
                    : dados.ddd_telefone_1;
            }

            var logradouro = dados.logradouro ?? "";
            var numero     = dados.numero     ?? "";
            var comp       = dados.complemento ?? "";
            endereco = string.Join(", ", new[] { logradouro, numero, comp }
                .Where(s => !string.IsNullOrWhiteSpace(s)));

            cidade = dados.municipio ?? cidade;
            uf     = dados.uf        ?? uf;
            cep    = dados.cep != null
                ? Regex.Replace(dados.cep, @"(\d{5})(\d{3})", "$1-$2")
                : cep;

            cnpjEncontrado  = true;
            documentoValido = true;
        }
        catch
        {
            erroDocumento = "Erro ao consultar CNPJ. Preencha os dados manualmente.";
        }
        finally
        {
            buscando = false;
            StateHasChanged();
        }
    }

    // ── Validação CPF ─────────────────────────────────────────────────
    private static bool ValidarCpf(string cpf)
    {
        if (cpf.Distinct().Count() == 1) return false; // todos iguais (000.000.000-00)

        // Calcula 1º dígito verificador
        int soma = 0;
        for (int i = 0; i < 9; i++) soma += int.Parse(cpf[i].ToString()) * (10 - i);
        int resto = soma % 11;
        int d1 = resto < 2 ? 0 : 11 - resto;
        if (int.Parse(cpf[9].ToString()) != d1) return false;

        // Calcula 2º dígito verificador
        soma = 0;
        for (int i = 0; i < 10; i++) soma += int.Parse(cpf[i].ToString()) * (11 - i);
        resto = soma % 11;
        int d2 = resto < 2 ? 0 : 11 - resto;
        return int.Parse(cpf[10].ToString()) == d2;
    }

    // ── Validação CNPJ ────────────────────────────────────────────────
    private static bool ValidarCnpj(string cnpj)
    {
        if (cnpj.Distinct().Count() == 1) return false;

        int[] mult1 = { 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2 };
        int[] mult2 = { 6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2 };

        int soma = 0;
        for (int i = 0; i < 12; i++) soma += int.Parse(cnpj[i].ToString()) * mult1[i];
        int resto = soma % 11;
        int d1 = resto < 2 ? 0 : 11 - resto;
        if (int.Parse(cnpj[12].ToString()) != d1) return false;

        soma = 0;
        for (int i = 0; i < 13; i++) soma += int.Parse(cnpj[i].ToString()) * mult2[i];
        resto = soma % 11;
        int d2 = resto < 2 ? 0 : 11 - resto;
        return int.Parse(cnpj[13].ToString()) == d2;
    }

    // ── Salvar ────────────────────────────────────────────────────────
    async Task Salvar()
    {
        erro = "";
        sucesso = "";

        if (string.IsNullOrWhiteSpace(razao))
        {
            erro = tipoPessoa == "J" ? "Razao Social e obrigatoria." : "Nome Completo e obrigatorio.";
            return;
        }

        var digitos = Regex.Replace(documento, @"[^\d]", "");
        if (tipoPessoa == "J" && digitos.Length != 14)
        {
            erro = "CNPJ invalido ou nao preenchido.";
            return;
        }
        if (tipoPessoa == "F" && digitos.Length != 11)
        {
            erro = "CPF invalido ou nao preenchido.";
            return;
        }

        if (maxDesktops < 1) { erro = "Max. Desktops deve ser no minimo 1."; return; }

        salvando = true;
        try
        {
            if (Id == 0)
            {
                var req = new CriarClienteRequest(razao, fantasia, documento, email, fone,
                    endereco, cidade, uf, cep, plano, maxDesktops, maxMobile, vencimento);
                var c = await Api.CriarClienteAsync(req);
                sucesso = $"Cliente criado com sucesso! Chave de licenca: {c?.Chave}";
                await Task.Delay(2000);
                Nav.NavigateTo($"/clientes/{c?.Id}");
            }
            else
            {
                var req = new AtualizarClienteRequest(razao, fantasia, email, fone,
                    endereco, cidade, uf, cep, plano, maxDesktops, maxMobile);
                await Api.AtualizarClienteAsync(Id, req);

                var msgs = new List<string> { "Dados atualizados com sucesso!" };

                if (maxDesktops < desktopsAtivos)
                {
                    var (removidos, _) = await Api.RemoverExcedentesAsync(Id, "DESKTOP", maxDesktops);
                    if (removidos > 0) msgs.Add($"{removidos} Desktop(s) desconectado(s) automaticamente.");
                }
                if (maxMobile < mobileAtivos)
                {
                    var (removidos, _) = await Api.RemoverExcedentesAsync(Id, "MOBILE", maxMobile);
                    if (removidos > 0) msgs.Add($"{removidos} Mobile(s) desconectado(s) automaticamente.");
                }

                sucesso = string.Join(" ", msgs);
                maxDesktopsOriginal = maxDesktops;
                maxMobileOriginal   = maxMobile;
                desktopsAtivos      = Math.Min(desktopsAtivos, maxDesktops);
                mobileAtivos        = Math.Min(mobileAtivos, maxMobile);
            }
        }
        catch (Exception ex) { erro = $"Erro: {ex.Message}"; }
        finally { salvando = false; }
    }

    // ── DTO BrasilAPI ─────────────────────────────────────────────────
    private class BrasilApiCnpjDto
    {
        public string? razao_social   { get; set; }
        public string? nome_fantasia  { get; set; }
        public string? email          { get; set; }
        public string? ddd_telefone_1 { get; set; }
        public string? logradouro     { get; set; }
        public string? numero         { get; set; }
        public string? complemento    { get; set; }
        public string? municipio      { get; set; }
        public string? uf             { get; set; }
        public string? cep            { get; set; }
    }
}
