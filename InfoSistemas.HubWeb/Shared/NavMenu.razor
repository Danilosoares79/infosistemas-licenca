@using InfoSistemas.HubWeb.Services
@inject AuthState AuthState
@implements IDisposable

<nav class="nav-menu">
    <NavLink href="/" Match="NavLinkMatch.All" class="nav-item" @onclick="Fechar">Dashboard</NavLink>
    <NavLink href="/clientes" class="nav-item" @onclick="Fechar">Clientes</NavLink>

    @if (AuthState.CanEditClientes)
    {
        <NavLink href="/clientes/novo" class="nav-item" @onclick="Fechar">Novo Cliente</NavLink>
    }

    <NavLink href="/financeiro/vencimentos" class="nav-item" @onclick="Fechar">Vencimentos</NavLink>

    @if (AuthState.CanViewPagamentos)
    {
        <NavLink href="/financeiro/pagamentos" class="nav-item" @onclick="Fechar">Pagamentos</NavLink>
    }

    @if (AuthState.CanViewUsuarios)
    {
        <NavLink href="/usuarios" class="nav-item" @onclick="Fechar">Usuarios</NavLink>
    }
</nav>

@if (AuthState.IsAuthenticated)
{
    <div class="nav-user">
        <div class="nav-user-info">
            <span class="nav-user-name">@AuthState.Usuario!.Nome</span>
            <span class="nav-user-login">@AuthState.Usuario.Login</span>
            <span class="nav-user-perfil @PerfilClass">@AuthState.Usuario.Perfil</span>
        </div>
        <div class="nav-user-actions">
            <NavLink href="/alterar-senha" class="nav-user-link" @onclick="Fechar">Alterar senha</NavLink>
            <button class="nav-user-btn" @onclick="Sair">Sair</button>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnNavClick { get; set; }
    [Inject] NavigationManager Nav { get; set; } = default!;

    protected override void OnInitialized() => AuthState.OnChange += StateHasChanged;
    public void Dispose() => AuthState.OnChange -= StateHasChanged;

    private async Task Fechar()
    {
        if (OnNavClick.HasDelegate)
            await OnNavClick.InvokeAsync();
    }

    private async Task Sair()
    {
        AuthState.Logout();
        await Fechar();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private string PerfilClass => AuthState.Usuario?.Perfil switch
    {
        "Admin"        => "badge-perfil admin",
        "Operador"     => "badge-perfil operador",
        "Visualizador" => "badge-perfil visualizador",
        _              => "badge-perfil"
    };
}
