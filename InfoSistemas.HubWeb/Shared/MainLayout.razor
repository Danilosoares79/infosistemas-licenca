@inherits LayoutComponentBase
@using InfoSistemas.HubWeb.Services
@using InfoSistemas.HubWeb.DTOs
@inject AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (carregando)
{
    <div class="auth-loading">Carregando...</div>
}
else if (!AuthState.IsAuthenticated)
{
    <div class="auth-loading">Redirecionando...</div>
}
else
{
    <div class="nav-overlay @(menuAberto ? "nav-overlay-ativo" : "")"
         @onclick="FecharMenu"></div>

    <div class="hub-layout">
        <nav class="hub-nav @(menuAberto ? "hub-nav-aberto" : "")">
            <div class="hub-brand">
                <img src="css/logo_infosistemas.jpg" alt="InfoSistemas" class="brand-logo"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"/>
                <div class="brand-fallback" style="display:none;">
                    <span class="brand-icon">IS</span>
                    <span class="brand-name">InfoSistemas Hub</span>
                </div>
            </div>
            <NavMenu />
        </nav>

        <main class="hub-main">
            <div class="mobile-topbar">
                <div class="mobile-brand">
                    <img src="css/logo_infosistemas.jpg" alt="IS" class="mobile-logo"
                         onerror="this.style.display='none';"/>
                    <span class="mobile-brand-name">InfoSistemas Hub</span>
                </div>
                <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
            <div class="hub-content">@Body</div>
        </main>
    </div>
}

@code {
    private bool menuAberto = false;
    private bool carregando = true;

    protected override void OnInitialized()
    {
        AuthState.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Se ja esta autenticado (ex: navLink soft navigation), nao precisa restaurar
        if (!AuthState.IsAuthenticated)
        {
            await TentarRestaurarSessaoAsync();
        }

        carregando = false;

        // Redirecionar se necessario
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath;

        if (!AuthState.IsAuthenticated)
        {
            if (!path.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/login");
        }
        else if (AuthState.MustChangePassword)
        {
            if (!path.StartsWith("/alterar-senha", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/alterar-senha");
        }

        StateHasChanged();
    }

    private async Task TentarRestaurarSessaoAsync()
    {
        try
        {
            // Primeiro tenta localStorage (lembrar de mim), depois sessionStorage
            string? json = null;
            try { json = await JS.InvokeAsync<string?>("localStorage.getItem", "is_sessao"); } catch { }
            if (string.IsNullOrEmpty(json))
            {
                try { json = await JS.InvokeAsync<string?>("sessionStorage.getItem", "is_sessao"); } catch { }
            }

            if (!string.IsNullOrEmpty(json))
            {
                var sessao = System.Text.Json.JsonSerializer.Deserialize<SessaoSalva>(json);
                if (sessao != null)
                {
                    var usuario = new UsuarioDto(
                        sessao.Id, sessao.Login, sessao.Nome,
                        sessao.Email, sessao.Perfil, sessao.Ativo,
                        sessao.UltimoAcesso, sessao.DataCriacao);
                    AuthState.SetUsuario(usuario, sessao.TrocarSenha);
                }
            }
        }
        catch { /* Falha silenciosa — usuario tera que logar novamente */ }
    }

    private void ToggleMenu() => menuAberto = !menuAberto;
    private void FecharMenu()  => menuAberto = false;

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
    }

    private record SessaoSalva(
        int Id, string Login, string Nome, string? Email,
        string Perfil, bool Ativo, DateTime? UltimoAcesso,
        DateTime DataCriacao, bool TrocarSenha);
}
