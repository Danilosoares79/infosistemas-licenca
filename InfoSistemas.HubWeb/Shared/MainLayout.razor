@inherits LayoutComponentBase
@using InfoSistemas.HubWeb.Services
@inject AuthState AuthState
@inject NavigationManager Nav
@implements IDisposable

@if (!AuthState.IsAuthenticated)
{
    <div class="auth-loading">Redirecionando para login...</div>
}
else
{
    <div class="hub-layout">
        <nav class="hub-nav">
            <!-- Logo InfoSistemas no topo -->
            <div class="hub-brand">
                <img src="css/logo_infosistemas.jpg"
                     alt="InfoSistemas"
                     class="brand-logo"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="brand-fallback" style="display:none;">
                    <span class="brand-icon">IS</span>
                    <span class="brand-name">InfoSistemas Hub</span>
                </div>
            </div>
            <NavMenu />
        </nav>
        <main class="hub-main">
            <div class="hub-content">
                @Body
            </div>
        </main>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AuthState.OnChange += StateHasChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!AuthState.IsAuthenticated)
        {
            var uri = new Uri(Nav.Uri);
            if (!uri.AbsolutePath.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/login");
        }
        else if (AuthState.MustChangePassword)
        {
            var uri = new Uri(Nav.Uri);
            if (!uri.AbsolutePath.StartsWith("/alterar-senha", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/alterar-senha");
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
    }
}
